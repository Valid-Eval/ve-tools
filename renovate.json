{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "labels": [
    "renovate"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "schedule": [
    "after 6am on sunday"
  ],
  "prHourlyLimit": 1,
  "prConcurrentLimit": 3,
  "ignorePaths": [
    "scratch/**"
  ],
  "packageRules": [
    {
      "description": "Group GitHub Actions SHA pinning and updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "commitMessageTopic": "github-actions"
    },
    {
      "description": "Group Go module updates for credbridge",
      "matchManagers": [
        "gomod"
      ],
      "groupName": "Go Modules",
      "commitMessageTopic": "go-modules"
    },
    {
      "description": "Require dashboard approval for major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "addLabels": [
        "major-update"
      ]
    },
    {
      "description": "libpq: stay on PostgreSQL 17, and take patch releases promptly. PostgreSQL patch releases are mostly security fixes, so skip the repo-wide 7-day age gate and weekly schedule. epoch stays 0 on a version bump; only a same-version rebuild bumps it.",
      "matchDepNames": [
        "postgres/postgres"
      ],
      "allowedVersions": "/^REL_17_\\d+$/",
      "minimumReleaseAge": "0 days",
      "schedule": [
        "at any time"
      ],
      "labels": [
        "renovate",
        "fips",
        "security"
      ]
    }
  ],
  "customManagers": [
    {
      "description": "PostgreSQL source pin in melange/libpq-17.yaml: tag, commit and package version move together. Custom regex groups are not available to autoReplaceStringTemplate, so the three lines must stay adjacent; the version is derived from the tag (REL_17_11 -> 17.11) with the built-in replace helper. Verified end to end with Renovate 44.132.2's doAutoReplace, 2026-10-02.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^melange/libpq-17\\.yaml$/"
      ],
      "matchStrings": [
        "pg-tag: (?<currentValue>REL_17_\\d+)\\n  pg-commit: (?<currentDigest>[0-9a-f]{40})\\npackage:\\n  version: \"[0-9.]+\""
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "postgres/postgres",
      "versioningTemplate": "regex:^REL_(?<major>\\d+)_(?<minor>\\d+)$",
      "autoReplaceStringTemplate": "pg-tag: {{{newValue}}}\n  pg-commit: {{{newDigest}}}\npackage:\n  version: \"{{{replace '^REL_(\\d+)_(\\d+)$' '$1.$2' newValue}}}\""
    },
    {
      "description": "Digest-pinned melange image in melange/build.sh (Renovate's dockerfile manager cannot see a script).",
      "customType": "regex",
      "managerFilePatterns": [
        "/^melange/build\\.sh$/"
      ],
      "matchStrings": [
        "MELANGE_IMAGE=\"(?<depName>cgr\\.dev/chainguard/melange):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[0-9a-f]{64})\""
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
